# Copie este arquivo para ".env.local" (não commitado) e preencha com os
# valores do JSON baixado na criação da Service Account no Google Cloud.
#
# No JSON baixado, os campos correspondentes são:
#   GOOGLE_CLIENT_EMAIL  -> campo "client_email"
#   GOOGLE_PRIVATE_KEY   -> campo "private_key"

# E-mail da Service Account (ex: calendario-bot@seu-projeto.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# Chave privada da Service Account. Cole o valor exatamente como está no JSON,
# entre aspas duplas, mantendo os "\n" literais (não substitua por quebras de linha reais).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# ID da agenda do Google que foi compartilhada com a Service Account.
# Normalmente é o seu próprio e-mail (o dono da agenda compartilhada).
GOOGLE_CALENDAR_ID=
